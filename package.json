{
  "name": "sentinel-one-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified incident management platform for municipal operations",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "db:setup": "cd packages/database && pnpm run db:setup",
    "db:seed": "cd packages/database && pnpm run db:seed",
    "db:reset": "cd packages/database && pnpm run db:reset",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker-compose -f infrastructure/docker/docker-compose.yml logs -f",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules pnpm-lock.yaml"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "vitest": "^1.0.0"
  }
}
